# DEMO environment: points the proxy at the local mock upstream
# (demo/mock_upstream.py on port 9999, started by demo/run-demo.ps1).
# Committed on purpose - it contains no secrets.
#
# For a REAL endpoint, use .env instead (see .env.example) and run
# `docker compose up -d --build` without the ENV_FILE override.

RUNPOD_SERVERLESS_URL=http://host.docker.internal:9999
RUNPOD_API_KEY=demo-rp-key
WARMUP_PATH=v1/models

# Short intervals so the full lifecycle (warm -> keepalive -> idle give-up)
# is visible in ~15 seconds during a live demo.
KEEPALIVE_INTERVAL_S=2
IDLE_GIVEUP_S=8
WARMUP_TIMEOUT_S=120
WARMUP_BACKOFF_MAX_S=2
PORT=8080
LOG_LEVEL=INFO
