{
  "title": "RunPod Proxy",
  "uid": "runpod-proxy",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "refresh": 1,
        "hide": 0
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Endpoint state",
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "COLD", "color": "orange" }, "1": { "text": "ACTIVE", "color": "green" } } },
            { "type": "regex", "options": { "pattern": "^.*WARM", "result": [ { "text": "WARM", "color": "green" } ] } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "orange", "value": null } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "sum by (state) (runpod_proxy_state)", "legendFormat": "{{state}}", "instant": true }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active model",
      "gridPos": { "h": 5, "w": 8, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] } }, "overrides": [] },
      "options": { "colorMode": "none", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "runpod_proxy_active_model", "legendFormat": "{{model}}", "instant": true }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Uptime (s)",
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "colorMode": "none", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "runpod_proxy_uptime_s", "legendFormat": "uptime" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Request rate (req/s)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(runpod_proxy_requests_total[5m]))", "legendFormat": "total" },
        { "refId": "B", "expr": "sum(rate(runpod_proxy_requests_warm_hit[5m]))", "legendFormat": "warm hit" },
        { "refId": "C", "expr": "sum(rate(runpod_proxy_requests_cold_hit[5m]))", "legendFormat": "cold hit" },
        { "refId": "D", "expr": "sum(rate(runpod_proxy_requests_failed[5m]))", "legendFormat": "failed" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Upstream latency (time to response headers)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum(rate(runpod_proxy_request_duration_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(runpod_proxy_request_duration_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum(rate(runpod_proxy_request_duration_seconds_bucket[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Request rate by model",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (model) (rate(runpod_proxy_requests_by_model[5m]))", "legendFormat": "{{model}}" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Warmups (per 5m window rate)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(runpod_proxy_warmups[5m]))", "legendFormat": "warmups" },
        { "refId": "B", "expr": "sum(rate(runpod_proxy_keepalive_failures_total[5m]))", "legendFormat": "keepalive failures" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Pod lifecycle (rate)",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(runpod_proxy_pod_starts[5m]))", "legendFormat": "pod starts" },
        { "refId": "B", "expr": "sum(rate(runpod_proxy_pod_creates[5m]))", "legendFormat": "pod creates" },
        { "refId": "C", "expr": "sum(rate(runpod_proxy_pods_replaced[5m]))", "legendFormat": "pods replaced" },
        { "refId": "D", "expr": "sum(rate(runpod_proxy_discoveries[5m]))", "legendFormat": "discoveries" },
        { "refId": "E", "expr": "sum(rate(runpod_proxy_model_switches[5m]))", "legendFormat": "model switches" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "GPU availability level (pod mode; 3=HIGH 2=MEDIUM 1=LOW 0=NONE)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 3,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "orange", "value": 1 },
            { "color": "light-blue", "value": 2 },
            { "color": "green", "value": 3 }
          ] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "runpod_proxy_gpu_availability_level", "legendFormat": "{{gpu}}" }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "GPU availability data age (s)",
      "gridPos": { "h": 8, "w": 4, "x": 12, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 3600 },
            { "color": "red", "value": 86400 }
          ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "runpod_proxy_gpu_availability_age_s", "legendFormat": "age" }
      ]
    }
  ]
}
