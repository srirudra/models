# Base URL of your RunPod serverless endpoint (required in serverless mode).
# The proxy APPENDS the client's path verbatim to this URL, so do NOT include /v1 here.
# Standard endpoints:  https://<endpoint-id>.api.runpod.ai
# OpenAI-compatible:   https://api.runpod.ai/v2/<endpoint-id>
RUNPOD_SERVERLESS_URL=https://<endpoint-id>.api.runpod.ai

# Backend mode: "serverless" (default, queue-based endpoint) or "pod"
# (persistent GPU pod started/stopped via the RunPod REST API).
RUNPOD_MODE=serverless

# Pod mode: pin one pod (leave empty to discover a pod by model instead).
RUNPOD_POD_ID=

# What to do when a pinned pod's start is blocked because its original host
# has no free GPU ("please migrate your pod" prompt, or the REST 500 "not
# enough free GPUs on the host machine"): the host assignment is sticky, so
# plain retries can never succeed.
#   fail    (default) - surface the error; the pod is left untouched
#   replace           - terminate the pod and create a fresh one with the
#                       same spec (same template/GPUs, network volume
#                       re-attached so on-disk data such as HF model weights
#                       is not re-downloaded), then keep serving via the new
#                       pod id. Update RUNPOD_POD_ID to the replacement's id
#                       afterwards so a proxy restart pins the survivor.
#RUNPOD_ON_MIGRATE=replace

# Pod discovery only: model identifier used to find matching pods/templates.
# Active only in pod mode when RUNPOD_POD_ID is empty. Also the default model
# for per-request routing (see RUNPOD_ALLOWED_MODELS below).
RUNPOD_MODEL_NAME=

# Pod discovery only: comma-separated allowlist enabling per-request model
# routing. When set, the proxy reads the JSON body's "model" field and routes
# to a matching entry (matched case-insensitively and by slug, so Qwen/Qwen3-32B
# and qwen-qwen3-32b match the same entry); the canonical spelling here is used
# downstream. A disallowed model returns HTTP 400. Leave empty to ignore the
# requested model and always use the default. The proxy serves ONE model at a
# time; switching models stops and re-discovers a pod, so keep this list small.
# Superseded by the model catalogue (RUNPOD_MODELS_FILE/JSON) when configured.
RUNPOD_ALLOWED_MODELS=

# Pod discovery only: declarative model catalogue mapping each model to RunPod
# template names and GPU preferences (see README "Declarative model
# catalogue"). Set at most one of the two below. When a catalogue is present it
# supersedes RUNPOD_ALLOWED_MODELS as the per-request allowlist, drives precise
# template-id matching, and validates at startup (the proxy refuses to boot on
# an invalid catalogue). See models.example.yaml (or models.example.json) for
# the schema.
#
# RUNPOD_MODELS_FILE: path to a catalogue file — JSON or YAML, the extension
# picks the parser (YAML is read with safe_load; wins if both are set).
# Under Docker, the default container path is /app/models.yaml (the compose
# file mounts a host file there read-only; change the container side with the
# CONTAINER_MODELS_FILE compose variable). Choose the host-side source with
# the MODELS_FILE variable, which is a COMPOSE INTERPOLATION variable — it is
# read by docker-compose, NOT by the app. It must therefore live in your shell
# environment or a compose ".env" file; setting MODELS_FILE inside ENV_FILE will
# NOT work, because env_file values are injected into the container only and are
# never used for interpolation.
RUNPOD_MODELS_FILE=
# RUNPOD_MODELS_JSON: the catalogue inline as JSON (handy for docker-compose).
# It must be ONE line — env_file does not support multi-line values, so the JSON
# cannot be pretty-printed. Write the raw JSON directly after "=": NO surrounding
# quotes and NO escaping are needed. Avoid "$" in any value, because
# docker-compose would attempt variable interpolation on it (model, template and
# GPU names normally contain none). RUNPOD_MODELS_FILE wins if both are set. Once
# the catalogue grows beyond a model or two, switch to the file form — a single
# line quickly becomes unreadable. Example (leave the active line below empty so
# the default stays unset):
# RUNPOD_MODELS_JSON={"models":[{"name":"Qwen/Qwen3.8-27B-FP8","templates":["qwen3-vllm-fp8"],"gpus":[{"id":"NVIDIA H100 80GB HBM3","min":1,"max":2}]}]}
RUNPOD_MODELS_JSON=
# RUNPOD_MODELS_YAML: the same inline catalogue but written as YAML instead of
# JSON — an alternate form of RUNPOD_MODELS_JSON for when YAML is easier to hand
# off. YAML is a superset of JSON, so single-line flow syntax works here too, but
# env_file still does not support multi-line values, so keep it on ONE line. The
# same "$" interpolation caveat applies. Precedence: RUNPOD_MODELS_FILE wins over
# both inline forms, and RUNPOD_MODELS_JSON wins over RUNPOD_MODELS_YAML when both
# are set. Example (leave the active line below empty so the default stays unset):
# RUNPOD_MODELS_YAML={models: [{name: "Qwen/Qwen3.8-27B-FP8", templates: [qwen3-vllm-fp8], gpus: [{id: "NVIDIA H100 80GB HBM3", min: 1, max: 2}]}]}
RUNPOD_MODELS_YAML=

# Per-request routing: best-effort seconds to drain in-flight requests before
# stopping the current pod on a model switch. The switch proceeds when it
# expires (in-flight requests may then be cut off).
MODEL_SWITCH_DRAIN_S=30

# Pod discovery only: automatically provision a real, billable GPU. Keep false
# unless automatic pod creation and its cost are intended.
RUNPOD_ALLOW_POD_CREATE=false

# Pod discovery creation: comma-separated GPU type IDs, tried in this order.
RUNPOD_GPU_TYPE_IDS=

# Pod discovery creation: "availability" or "custom" (strict GPU ID order).
RUNPOD_GPU_TYPE_PRIORITY=availability

# Pod discovery creation: RunPod cloud type.
RUNPOD_CLOUD_TYPE=SECURE

# Pod discovery creation: optional exact template name; empty matches by model
# (or uses the catalogue's templates list when a catalogue is configured).
RUNPOD_TEMPLATE_NAME=

# Pod discovery creation: hard cap on create attempts per discovery when
# walking the catalogue's template x GPU x count matrix. Bounds a pathological
# catalogue; a successful create ends the matrix immediately.
RUNPOD_MAX_CREATE_ATTEMPTS=12

# Pod discovery: re-resolve after this many seconds since the last successful
# request, to detect pods stopped/deleted/reclaimed externally.
POD_REVALIDATE_S=300

# Pod discovery: health-probe and desiredStatus=RUNNING budgets (seconds).
POD_HEALTH_TIMEOUT_S=180
POD_READY_TIMEOUT_S=120

# Pod-mode readiness bar — how strict the warmup-route probe must be before the
# proxy declares the backend WARM (serverless mode always uses "any"):
#   model     (default) warmup route's JSON must list the target model
#   any       any non-synthetic HTTP response (legacy; only safe for servers that
#             refuse to answer before the model is loaded, e.g. vLLM /v1/models)
#   completion a real 1-token chat completion must succeed (strictest; one
#             inference per cold start)
# "model" guards against backends that answer HTTP while weights are still
# loading — declaring WARM early would stall the first real request for minutes.
#POD_HEALTH_MODE=model

# Circuit breaker: after this many consecutive reclaims (started but never
# became healthy) for the active model, start() fails fast for the cooldown
# period below instead of repeating a doomed multi-minute boot cycle. Guards
# against a crash-looping pod (e.g. bad launch args) being hammered on every
# client retry. Set the threshold to 0 to disable.
POD_CIRCUIT_BREAKER_THRESHOLD=3
POD_CIRCUIT_BREAKER_COOLDOWN_S=300

# Pod discovery creation: optional sizes; empty uses the template defaults.
RUNPOD_CONTAINER_DISK_GB=
RUNPOD_VOLUME_GB=

# Pod mode only: HTTP port your server listens on inside the pod. The upstream
# URL is derived as https://<pod-id>-<port>.proxy.runpod.net
RUNPOD_POD_PORT=8000

# Pod mode only: explicit upstream URL; overrides the derived one above.
RUNPOD_POD_URL=

# RunPod REST API base used for pod start/stop (rarely needs changing).
RUNPOD_REST_URL=https://rest.runpod.io/v1

# GPU availability polling (pod mode only): how often (seconds) the proxy
# refreshes last-known RunPod GPU availability for the catalogue's GPU types.
# 0 = off. On a failing poll the last-known values are kept and the age +
# last error are surfaced in /_status (gpu_availability) and /metrics.
GPU_AVAILABILITY_INTERVAL_S=300

# RunPod v2 API base used by the availability poller (rarely needs changing).
RUNPOD_AVAILABILITY_URL=https://api.runpod.io/v2

# Your RunPod API key. In serverless mode it authenticates upstream requests.
# In pod mode it is used only for REST start/stop lifecycle calls.
RUNPOD_API_KEY=

# Optional model-server key. When set, the proxy injects it into warmup,
# keepalive, and forwarded requests. In pod mode, leave this empty for an
# unauthenticated server or set it to the key configured in vLLM/API server.
RUNPOD_UPSTREAM_API_KEY=

# For pods whose model-server API key is derived from the pod's own id (e.g.
# some vLLM templates set VLLM_API_KEY=sk-$RUNPOD_POD_ID), set a template
# with a {pod_id} placeholder and the proxy derives the correct key per pod
# automatically instead of a static RUNPOD_UPSTREAM_API_KEY going stale every
# time discovery creates/replaces a pod. Takes precedence over
# RUNPOD_UPSTREAM_API_KEY whenever a pod id is known.
# NOTE: write the placeholder literally as {pod_id}. Do NOT use
# $RUNPOD_POD_ID — docker-compose expands $VARIABLES at deploy time, which
# would freeze the key at the id that was current at last deploy and break
# auth on any replacement pod.
#RUNPOD_UPSTREAM_API_KEY_TEMPLATE=sk-{pod_id}
RUNPOD_UPSTREAM_API_KEY_TEMPLATE=

# Port the proxy listens on. NOTE: ignored by the Docker build (the container
# always listens on 8080); only meaningful when running the binary directly (cargo run).
PORT=8080

# Path (relative to the base URL) used for warmup/keepalive pings.
# Serverless mode: any HTTP response (even 4xx/5xx) counts as "worker is up".
# Pod mode: the response is classified per POD_HEALTH_MODE (default: the model
# must be listed). Works with any OpenAI-compatible worker: GET {base}/v1/models.
WARMUP_PATH=v1/models

# Max total time (seconds) to wait for the endpoint to come up
WARMUP_TIMEOUT_S=600

# Cap for the backoff between warmup retries (seconds)
WARMUP_BACKOFF_MAX_S=15

# Keepalive heartbeat period (seconds) while the endpoint is warm
KEEPALIVE_INTERVAL_S=25

# Stop keepalives after this much real-client idle time (seconds),
# letting the endpoint go idle so you stop paying for it
IDLE_GIVEUP_S=600

# Per-request upstream timeout (seconds)
REQUEST_TIMEOUT_S=300

# Max request body size in bytes before the proxy rejects with HTTP 413.
# Guards the proxy's memory against unbounded uploads. 0 = unlimited.
MAX_BODY_BYTES=52428800

# Comma-separated local times (HH:MM) at which the proxy pre-warms the active
# model (in discovery mode this discovers/creates the pod, so the first real
# request of the day is a warm hit). Empty = off. Uses the container's local
# time (set TZ in the container/compose if it should be a specific zone).
PREWARM_TIMES=

# Optional shared secret for the proxy itself. When set, every route except
# /_health requires it as `x-proxy-key: <key>` or `Authorization: Bearer <key>`.
# Strongly recommended if the proxy is reachable beyond localhost: it attaches
# your RunPod key to whatever it forwards.
PROXY_API_KEY=

# Logging: DEBUG / INFO / WARNING
LOG_LEVEL=INFO
# Log format: text (default) or json (one JSON object per line, for log shippers)
LOG_FORMAT=text
